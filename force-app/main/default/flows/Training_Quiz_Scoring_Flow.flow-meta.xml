<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Training Quiz Scoring Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Result</targetReference>
        </connector>
        <object>Training_Question__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <decisions>
        <name>Check_Result</name>
        <label>Check Result</label>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Failed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Answer_Correct</name>
            <label>Answer Correct</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Is_Correct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Passed</targetReference>
            </connector>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Passed</name>
        <label>Set Passed</label>
        <locationX>352</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>100</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Failed</name>
        <label>Set Failed</label>
        <locationX>352</locationX>
        <locationY>100</locationY>
        <assignmentItems>
            <assignToReference>$Record.Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <status>Active</status>
</Flow>
