            <operator>Assign</operator>
            <value>
                <stringValue>Tier 2 Support</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Tier1</name>
        <label>Set Tier1</label>
        <locationX>352</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>$Record.Agent_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 1 Support</stringValue>
            </value>
