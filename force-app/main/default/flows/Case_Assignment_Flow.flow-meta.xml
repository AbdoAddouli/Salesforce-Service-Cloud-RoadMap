<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Case Assignment Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decide_Route</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <decisions>
        <name>Decide_Route</name>
        <label>Decide Route</label>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Tier1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>High_Priority</name>
            <label>High Priority</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Escalation</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Medium_Priority</name>
            <label>Medium Priority</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier2</targetReference>
            </connector>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Escalation</name>
        <label>Set Escalation</label>
        <locationX>352</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Agent_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
